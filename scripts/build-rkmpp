#!/usr/bin/env bash

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build_root="${RKMPP_BUILD_ROOT:-${project_root}/.rkmpp-build}"
source_root="${build_root}/src"
ffmpeg_source="${source_root}/ffmpeg-rockchip"
ffmpeg_prefix="${ffmpeg_source}/.ci-build/shared/prefix"
venv_dir="${build_root}/venv"
runtime_venv_dir="${build_root}/runtime-venv"
output_dir="${project_root}/dist-rkmpp"
wheel_build_dir="${build_root}/wheel-output"
wheel_pattern='pyav_rkmpp-*.whl'

ffmpeg_repo="${FFMPEG_ROCKCHIP_REPO:-https://github.com/happyme531/ffmpeg-rockchip.git}"
ffmpeg_ref="${FFMPEG_ROCKCHIP_REF:-de4b44643eaf55ed21cf7d02ae22a00c18579c9a}"
jobs="${JOBS:-$(getconf _NPROCESSORS_ONLN)}"

# The host and board expose the same shared tree with different numeric owners.
# Trust repositories only for this build process; do not mutate global Git config.
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0=safe.directory
export GIT_CONFIG_VALUE_0='*'

if [[ "$(uname -m)" != "aarch64" && "$(uname -m)" != "arm64" ]]; then
  echo "ERROR: run this build on an ARM64 host" >&2
  exit 1
fi

python_bin="${PYTHON_BIN:-}"
if [[ -z "${python_bin}" ]]; then
  for candidate in python3.13 python3.12 python3.11 /home/firefly/miniconda3/bin/python; do
    if (command -v "${candidate}" >/dev/null 2>&1 || [[ -x "${candidate}" ]]) \
      && "${candidate}" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))'; then
      python_bin="${candidate}"
      break
    fi
  done
fi
if [[ -z "${python_bin}" ]]; then
  echo "ERROR: PyAV 18.1 requires Python >= 3.11" >&2
  exit 1
fi

mkdir -p "${source_root}" "${output_dir}"
if [[ ! -x "${venv_dir}/bin/python" ]]; then
  "${python_bin}" -m venv "${venv_dir}"
fi

"${venv_dir}/bin/python" -m pip install --upgrade \
  'setuptools==80.9.0' \
  'Cython==3.1.3' \
  'wheel==0.45.1' \
  'build==1.2.2.post1' \
  'meson==0.63.3'
export PATH="${venv_dir}/bin:${PATH}"

for command_name in cmake git meson ninja pkg-config; do
  if ! command -v "${command_name}" >/dev/null 2>&1; then
    echo "ERROR: missing build tool: ${command_name}" >&2
    exit 1
  fi
done

if [[ ! -d "${ffmpeg_source}/.git" ]]; then
  mkdir -p "${ffmpeg_source}"
  git -C "${ffmpeg_source}" init
  git -C "${ffmpeg_source}" remote add origin "${ffmpeg_repo}"
fi

if [[ -n "$(git -C "${ffmpeg_source}" status --porcelain --untracked-files=no)" ]]; then
  echo "ERROR: refusing to replace a modified ffmpeg-rockchip checkout" >&2
  exit 1
fi

git -C "${ffmpeg_source}" fetch --depth 1 origin "${ffmpeg_ref}"
git -C "${ffmpeg_source}" checkout --detach --force FETCH_HEAD

ffmpeg_builder="${ffmpeg_source}/.github/scripts/build_ffmpeg_rockchip.sh"
isolated_home="${build_root}/build-home"
mkdir -p "${isolated_home}"

if [[ "${SKIP_FFMPEG_BUILD:-0}" != "1" || ! -x "${ffmpeg_prefix}/bin/ffmpeg" ]]; then
  HOME="${isolated_home}" "${ffmpeg_builder}" shared "${jobs}"
fi

if [[ ! -x "${ffmpeg_prefix}/bin/ffmpeg" ]]; then
  echo "ERROR: ffmpeg-rockchip shared build did not produce ffmpeg" >&2
  exit 1
fi

export PATH="${ffmpeg_prefix}/bin:${PATH}"
export LD_LIBRARY_PATH="${ffmpeg_prefix}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export PKG_CONFIG_PATH=
export PKG_CONFIG_LIBDIR="${ffmpeg_prefix}/lib/pkgconfig:${ffmpeg_prefix}/share/pkgconfig"
export CFLAGS="${CFLAGS:--O2}"

rm -rf "${wheel_build_dir}"
mkdir -p "${wheel_build_dir}"
"${venv_dir}/bin/python" -m pip wheel \
  --no-build-isolation \
  --no-deps \
  --wheel-dir "${wheel_build_dir}" \
  "${project_root}"

wheel_source="$(find "${wheel_build_dir}" -maxdepth 1 -type f -name "${wheel_pattern}" -print -quit)"
if [[ -z "${wheel_source}" ]]; then
  echo "ERROR: PyAV wheel was not produced" >&2
  exit 1
fi
cp -f "${wheel_source}" "${output_dir}/"
wheel_path="${output_dir}/$(basename "${wheel_source}")"

rm -rf "${runtime_venv_dir}"
"${python_bin}" -m venv "${runtime_venv_dir}"
"${runtime_venv_dir}/bin/python" -m pip install --force-reinstall --no-deps "${wheel_path}"

# Import outside the checkout so Python resolves the installed extension modules
# instead of the uncompiled pure-Python/Cython source tree.
installed_version="$(cd "${build_root}" && "${runtime_venv_dir}/bin/python" -c 'import av; print(av.__version__)')"

cat >"${build_root}/env.sh" <<EOF
export PATH='${ffmpeg_prefix}/bin':\"\${PATH}\"
export LD_LIBRARY_PATH='${ffmpeg_prefix}/lib'\${LD_LIBRARY_PATH:+:\"\${LD_LIBRARY_PATH}\"}
export PYAV_RKMPP_PYTHON='${runtime_venv_dir}/bin/python'
export PYAV_RKMPP_FFMPEG_PREFIX='${ffmpeg_prefix}'
EOF

cp -f "${ffmpeg_source}/dist/ffmpeg-rockchip-shared-"*.tar.gz "${output_dir}/"

{
  echo "pyav_commit=$(git -C "${project_root}" rev-parse HEAD)"
  echo "pyav_version=${installed_version}"
  echo "ffmpeg_rockchip_commit=$(git -C "${ffmpeg_source}" rev-parse HEAD)"
  echo "python=$(${venv_dir}/bin/python --version 2>&1)"
  echo "architecture=$(uname -m)"
  echo "kernel=$(uname -r)"
  echo "built_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} >"${output_dir}/BUILD_INFO.txt"

echo "PyAV wheel: ${wheel_path}"
echo "Runtime environment: source ${build_root}/env.sh"
